DEEPBINDER_ENV=development
DEEPBINDER_SECRET_KEY=replace-with-at-least-32-random-characters
DEEPBINDER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEEPBINDER_MAX_LOGIN_FAILURES=5
DEEPBINDER_LOGIN_FAILURE_WINDOW_SECONDS=300
DEEPBINDER_FOUNDRY_MODE=mock
DEEPBINDER_ALLOW_MOCK=1
DEEPBINDER_BOOTSTRAP_ADMIN_USERNAME=
DEEPBINDER_BOOTSTRAP_ADMIN_PASSWORD=
DEEPBINDER_BOOTSTRAP_ADMIN_EMAIL=admin@deepbinder.local
